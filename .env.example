# ==========================================
# The Stock (AI & JEV 주식 자동매매 시스템) 환경설정
# ==========================================

# 1. 한국투자증권(KIS) 실전투자 API 설정 (시세/순위/수급 수신용)
# 개발 및 검증 단계에서는 실제 계좌 키가 없어도 MOCK 모드로 시뮬레이션 동작합니다.
KIS_ENV=PROD
KIS_APP_KEY=your_prod_app_key_here
KIS_APP_SECRET=your_prod_app_secret_here
KIS_CANO=your_8_digit_account_no
KIS_ACNT_PRDT_CD=01

# 2. 체결 엔진 모드
# - SHADOW: KIS 실전 시세를 받아와 로컬 자체 SQLite 엔진(최불리 호가 + 슬리피지 + 차등세율)에서 가상 체결 (권장)
# - LIVE: 추후 실제 증권사 계좌로 주문 발주
EXECUTION_MODE=SHADOW

# 3. AI & JEV 설정
# OpenRouter API 키 (TypeSafe Jev-1.13 초고속 판단용)
OPENROUTER_API_KEY=your_openrouter_api_key_here
JEV_TIMEOUT_MS=700

# Google Gemini API 키 (장전 시황 브리핑 및 장후 일일 매매 복기용)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Firebase Realtime Database 모바일 관제 브리지 설정 (VPN 불필요)
# Firebase 콘솔에서 다운로드한 서비스 계정 키 파일 경로
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json
FIREBASE_DATABASE_URL=https://your-stock-default-rtdb.firebaseio.com/

# 5. 로컬 서버 설정
WEB_HOST=127.0.0.1
WEB_PORT=8000
SERVER_AUTH_TOKEN=generate_random_secret_token_here

# 6. 한국거래소(KRX) 정보데이터시스템(data.krx.co.kr) 공식 로그인 계정 (pykrx 수급/시총 조회용)
KRX_ID=your_krx_id_here
KRX_PW=your_krx_password_here
